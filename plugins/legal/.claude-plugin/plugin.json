{
  "name": "legal",
  "displayName": "Probanda Legal",
  "version": "0.0.1",
  "description": "The core Probanda plugin. Requires nothing. Install it first: every other Probanda plugin requires it.",
  "author": {
    "name": "Probanda",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Probanda",
  "repository": "https://github.com/Probanda-app/Probanda",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/dyu/hooks/trailing-dyu.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
