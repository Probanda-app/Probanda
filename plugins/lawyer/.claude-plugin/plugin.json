{
  "name": "lawyer",
  "displayName": "Lawyer",
  "version": "0.0.1",
  "description": "The core plugin, with skills for any lawyer: proof-read legal writing, restate a request before acting, and summarize a session. Requires nothing. Every other Probanda plugin requires it.",
  "author": {
    "name": "Probanda Legal",
    "url": "https://github.com/Probanda-app"
  },
  "homepage": "https://github.com/Probanda-app/Legal",
  "repository": "https://github.com/Probanda-app/Legal",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/skills/dyu/hooks/trailing-dyu.py"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
